# Copy this to .env locally. The file is gitignored.
# In cloud routines, set these as environment variables on the routine itself
# — do NOT create a .env file in the cloud.

# Alpaca
# Defaults below point at PAPER trading (simulated money, zero financial risk).
# To go LIVE later: change ALPACA_ENDPOINT to https://api.alpaca.markets/v2
# and swap in your live API keys. Do this deliberately — it's a one-line edit
# with real money consequences, not something to do by accident.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here


# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# Gmail (notifications — sent via Gmail SMTP with an app password)
# GMAIL_APP_PASSWORD is a 16-character app password, NOT your normal Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
# GMAIL_TO is usually the same address as GMAIL_ADDRESS if you're just
# sending notifications to yourself.
GMAIL_ADDRESS=your_gmail_address_here@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
GMAIL_TO=your_gmail_address_here@gmail.com
