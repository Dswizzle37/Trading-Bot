# Copy this to .env locally. The file is gitignored.
# In cloud routines, set these as environment variables on the routine itself
# — do NOT create a .env file in the cloud.

# Alpaca
# Defaults below point at PAPER trading (simulated money, zero financial risk).
# To go LIVE later: change ALPACA_ENDPOINT to https://api.alpaca.markets/v2
# and swap in your live API keys. Do this deliberately — it's a one-line edit
# with real money consequences, not something to do by accident.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here


# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# Notifications — Resend HTTPS API (works in cloud routines; SMTP does not,
# because those sandboxes only tunnel HTTPS/443). Get a key at resend.com.
# NOTIFY_FROM can stay as onboarding@resend.dev until you verify your own
# domain with Resend. NOTIFY_TO is where alerts land — your own email.
RESEND_API_KEY=your_resend_api_key_here
NOTIFY_FROM=onboarding@resend.dev
NOTIFY_TO=your_email_here@gmail.com

# Optional local-only fallback: if RESEND_API_KEY is unset but these are set,
# scripts/notify.sh falls back to Gmail SMTP. Works on your Mac, NOT in cloud
# routines. Safe to leave blank.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# GitHub push (cloud routines). Claude's GitHub App integration currently
# 403s on all writes, so routines authenticate with this token instead.
# Fine-grained token, repo-scoped to Trading-Bot, Contents: Read and write.
# Generate at https://github.com/settings/personal-access-tokens/new
GH_TOKEN=your_github_pat_here
GH_REPO=Dswizzle37/Trading-Bot
